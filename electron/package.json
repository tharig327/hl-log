{
  "name": "hl-floorsync",
  "version": "1.2.0",
  "description": "H&L FloorSync — Floor Issue Log & Maintenance",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 && node copy-to-updates.js",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hlmanufacturing.floorsync",
    "productName": "H&L FloorSync",
    "copyright": "Copyright © 2025 H&L Manufacturing",
    "icon": "../icon-512.png",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "files": [
      "main.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!db/**",
          "!node_modules/.cache/**"
        ]
      },
      {
        "from": "../",
        "to": "app",
        "filter": [
          "index.html",
          "maintenance.html",
          "manifest.json",
          "sw.js",
          "icon-*.png",
          "Splash.png",
          "qr.html",
          "sql.html",
          "t/**/*"
        ]
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "http://tyler.hl.local:3000/updates/"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "H&L FloorSync",
      "installerHeaderIcon": "../icon-192.png"
    },
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
